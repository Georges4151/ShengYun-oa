{
  "name": "@ceams/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "dev:web": "pnpm --filter @ceams/web dev",
    "start": "pnpm build && electron ."
  },
  "dependencies": {
    "@ceams/api-client": "workspace:*",
    "@ceams/types": "workspace:*",
    "@ceams/utils": "workspace:*",
    "drivelist": "^12.0.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.0.0",
    "typescript": "^5.9.3"
  }
}