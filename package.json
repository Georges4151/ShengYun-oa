{
  "name": "ceams",
  "version": "1.0.0",
  "private": true,
  "description": "CEAMS 建筑企业账目管理系统 - 三端 monorepo（web / desktop / miniprogram）",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ceams/web dev",
    "build": "pnpm --filter @ceams/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}