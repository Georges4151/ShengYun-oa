<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ceams.dao.PaymentAccountMapper">
    <resultMap id="BaseResultMap" type="com.ceams.model.entity.PaymentAccount">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="type" property="type" />
        <result column="balance" property="balance" />
        <result column="description" property="description" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, name, type, balance, description, create_time, update_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM payment_account
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM payment_account
        ORDER BY create_time DESC
    </select>

    <select id="selectByType" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM payment_account
        WHERE type = #{type}
        ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="com.ceams.model.entity.PaymentAccount">
        INSERT INTO payment_account
        (name, type, balance, description)
        VALUES
        (#{name}, #{type}, #{balance}, #{description})
    </insert>

    <update id="update" parameterType="com.ceams.model.entity.PaymentAccount">
        UPDATE payment_account
        SET
        name = #{name},
        type = #{type},
        balance = #{balance},
        description = #{description}
        WHERE id = #{id}
    </update>

    <update id="updateBalance">
        UPDATE payment_account
        SET balance = balance + #{amount}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM payment_account
        WHERE id = #{id}
    </delete>
</mapper>