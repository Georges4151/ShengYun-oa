<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ceams.dao.ElectronicSealMapper">
    <!-- 电子章表 -->
    <resultMap id="electronicSealMap" type="com.ceams.model.entity.ElectronicSeal">
        <id column="id" property="id" />
        <result column="seal_name" property="sealName" />
        <result column="seal_type" property="sealType" />
        <result column="description" property="description" />
        <result column="status" property="status" />
        <result column="seal_image" property="sealImage" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="storage_type" property="storageType" />
        <result column="seal_file_id" property="sealFileId" />
        <result column="usb_drive_id" property="usbDriveId" />
        <result column="password_protected" property="passwordProtected" />
        <result column="last_used_time" property="lastUsedTime" />
        <result column="usage_count" property="usageCount" />
    </resultMap>

    <!-- 电子章申请表 -->
    <resultMap id="electronicSealApplicationMap" type="com.ceams.model.entity.ElectronicSealApplication">
        <id column="id" property="id" />
        <result column="seal_id" property="sealId" />
        <result column="seal_name" property="sealName" />
        <result column="applicant_id" property="applicantId" />
        <result column="applicant_name" property="applicantName" />
        <result column="purpose" property="purpose" />
        <result column="status" property="status" />
        <result column="approver_id" property="approverId" />
        <result column="approver_name" property="approverName" />
        <result column="approval_comment" property="approvalComment" />
        <result column="apply_time" property="applyTime" />
        <result column="approval_time" property="approvalTime" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 电子章使用记录表 -->
    <resultMap id="electronicSealUsageMap" type="com.ceams.model.entity.ElectronicSealUsage">
        <id column="id" property="id" />
        <result column="seal_id" property="sealId" />
        <result column="seal_name" property="sealName" />
        <result column="user_id" property="userId" />
        <result column="user_name" property="userName" />
        <result column="purpose" property="purpose" />
        <result column="document_type" property="documentType" />
        <result column="document_path" property="documentPath" />
        <result column="usage_time" property="usageTime" />
        <result column="ip_address" property="ipAddress" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 电子章盖章表 -->
    <resultMap id="electronicSealStampMap" type="com.ceams.model.entity.ElectronicSealStamp">
        <id column="id" property="id" />
        <result column="seal_id" property="sealId" />
        <result column="seal_name" property="sealName" />
        <result column="project_id" property="projectId" />
        <result column="project_name" property="projectName" />
        <result column="contract_name" property="contractName" />
        <result column="contract_path" property="contractPath" />
        <result column="stamp_position" property="stampPosition" />
        <result column="stamp_image" property="stampImage" />
        <result column="stamp_time" property="stampTime" />
        <result column="user_id" property="userId" />
        <result column="user_name" property="userName" />
        <result column="ip_address" property="ipAddress" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 电子章相关SQL -->
    <select id="selectById" resultMap="electronicSealMap">
        SELECT * FROM electronic_seals WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="electronicSealMap">
        SELECT * FROM electronic_seals
    </select>

    <insert id="insert" parameterType="com.ceams.model.entity.ElectronicSeal">
        INSERT INTO electronic_seals (seal_name, seal_type, description, status, seal_image, 
            storage_type, seal_file_id, usb_drive_id, password_protected, usage_count, create_time, update_time)
        VALUES (#{sealName}, #{sealType}, #{description}, #{status}, #{sealImage}, 
            #{storageType}, #{sealFileId}, #{usbDriveId}, #{passwordProtected}, #{usageCount}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.ceams.model.entity.ElectronicSeal">
        UPDATE electronic_seals SET
            seal_name = #{sealName},
            seal_type = #{sealType},
            description = #{description},
            status = #{status},
            seal_image = #{sealImage},
            storage_type = #{storageType},
            seal_file_id = #{sealFileId},
            usb_drive_id = #{usbDriveId},
            password_protected = #{passwordProtected},
            last_used_time = #{lastUsedTime},
            usage_count = #{usageCount},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM electronic_seals WHERE id = #{id}
    </delete>

    <delete id="deleteStampBySealId">
        DELETE FROM electronic_seal_stamps WHERE seal_id = #{sealId}
    </delete>

    <delete id="deleteApplicationBySealId">
        DELETE FROM electronic_seal_applications WHERE seal_id = #{sealId}
    </delete>

    <delete id="deleteUsageBySealId">
        DELETE FROM electronic_seal_usages WHERE seal_id = #{sealId}
    </delete>

    <!-- 电子章申请相关 SQL -->
    <select id="selectApplicationById" resultMap="electronicSealApplicationMap">
        SELECT * FROM electronic_seal_applications WHERE id = #{id}
    </select>

    <select id="selectApplicationsByApplicantId" resultMap="electronicSealApplicationMap">
        SELECT * FROM electronic_seal_applications WHERE applicant_id = #{applicantId}
    </select>

    <select id="selectApplicationsByStatus" resultMap="electronicSealApplicationMap">
        SELECT * FROM electronic_seal_applications WHERE status = #{status}
    </select>

    <insert id="insertApplication" parameterType="com.ceams.model.entity.ElectronicSealApplication">
        INSERT INTO electronic_seal_applications (seal_id, seal_name, applicant_id, applicant_name, purpose, status, apply_time, create_time, update_time)
        VALUES (#{sealId}, #{sealName}, #{applicantId}, #{applicantName}, #{purpose}, #{status}, NOW(), NOW(), NOW())
    </insert>

    <update id="updateApplication" parameterType="com.ceams.model.entity.ElectronicSealApplication">
        UPDATE electronic_seal_applications SET
            status = #{status},
            approver_id = #{approverId},
            approver_name = #{approverName},
            approval_comment = #{approvalComment},
            approval_time = NOW(),
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 电子章使用记录相关SQL -->
    <select id="selectUsageById" resultMap="electronicSealUsageMap">
        SELECT * FROM electronic_seal_usages WHERE id = #{id}
    </select>

    <select id="selectUsagesBySealId" resultMap="electronicSealUsageMap">
        SELECT * FROM electronic_seal_usages WHERE seal_id = #{sealId}
    </select>

    <select id="selectUsagesByUserId" resultMap="electronicSealUsageMap">
        SELECT * FROM electronic_seal_usages WHERE user_id = #{userId}
    </select>

    <insert id="insertUsage" parameterType="com.ceams.model.entity.ElectronicSealUsage">
        INSERT INTO electronic_seal_usages (seal_id, seal_name, user_id, user_name, purpose, document_type, document_path, usage_time, ip_address, create_time, update_time)
        VALUES (#{sealId}, #{sealName}, #{userId}, #{userName}, #{purpose}, #{documentType}, #{documentPath}, NOW(), #{ipAddress}, NOW(), NOW())
    </insert>

    <delete id="deleteUsage">
        DELETE FROM electronic_seal_usages WHERE id = #{id}
    </delete>

    <!-- 电子章盖章相关SQL -->
    <insert id="insertStamp" parameterType="com.ceams.model.entity.ElectronicSealStamp">
        INSERT INTO electronic_seal_stamps (seal_id, seal_name, project_id, project_name, contract_name, 
            contract_path, stamp_position, stamp_image, user_id, user_name, stamp_time, ip_address, create_time, update_time)
        VALUES (#{sealId}, #{sealName}, #{projectId}, #{projectName}, #{contractName}, 
            #{contractPath}, #{stampPosition}, #{stampImage}, #{userId}, #{userName}, #{stampTime}, #{ipAddress}, NOW(), NOW())
    </insert>

    <select id="selectStampsByProjectId" resultMap="electronicSealStampMap">
        SELECT * FROM electronic_seal_stamps WHERE project_id = #{projectId}
    </select>

    <select id="selectStampsByUserId" resultMap="electronicSealStampMap">
        SELECT * FROM electronic_seal_stamps WHERE user_id = #{userId}
    </select>
    
    <select id="selectAllStamps" resultMap="electronicSealStampMap">
        SELECT * FROM electronic_seal_stamps
    </select>

    <!-- 盖章审批表 -->
    <resultMap id="stampApprovalMap" type="com.ceams.model.entity.StampApproval">
        <id column="id" property="id" />
        <result column="stamp_id" property="stampId" />
        <result column="contract_name" property="contractName" />
        <result column="contract_path" property="contractPath" />
        <result column="original_contract_path" property="originalContractPath" />
        <result column="stamp_positions" property="stampPositions" />
        <result column="seal_id" property="sealId" />
        <result column="seal_name" property="sealName" />
        <result column="seal_code" property="sealCode" />
        <result column="seal_permission" property="sealPermission" />
        <result column="project_id" property="projectId" />
        <result column="project_name" property="projectName" />
        <result column="applicant_id" property="applicantId" />
        <result column="applicant_name" property="applicantName" />
        <result column="approver_id" property="approverId" />
        <result column="approver_name" property="approverName" />
        <result column="status" property="status" />
        <result column="reject_reason" property="rejectReason" />
        <result column="apply_time" property="applyTime" />
        <result column="approval_time" property="approvalTime" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 盖章审批相关SQL -->
    <insert id="insertStampApproval" parameterType="com.ceams.model.entity.StampApproval">
        INSERT INTO stamp_approvals (stamp_id, contract_name, contract_path, original_contract_path, stamp_positions,
            seal_id, seal_name, seal_code, seal_permission, project_id, project_name, 
            applicant_id, applicant_name, status, apply_time, create_time, update_time)
        VALUES (#{stampId}, #{contractName}, #{contractPath}, #{originalContractPath}, #{stampPositions},
            #{sealId}, #{sealName}, #{sealCode}, #{sealPermission}, #{projectId}, #{projectName}, 
            #{applicantId}, #{applicantName}, #{status}, NOW(), NOW(), NOW())
    </insert>

    <select id="selectStampApprovalById" resultMap="stampApprovalMap">
        SELECT * FROM stamp_approvals WHERE id = #{id}
    </select>

    <select id="selectStampApprovalByStampId" resultMap="stampApprovalMap">
        SELECT * FROM stamp_approvals WHERE stamp_id = #{stampId}
    </select>

    <select id="selectStampApprovalsByApplicantId" resultMap="stampApprovalMap">
        SELECT * FROM stamp_approvals WHERE applicant_id = #{applicantId} ORDER BY apply_time DESC
    </select>

    <select id="selectStampApprovalsByStatus" resultMap="stampApprovalMap">
        SELECT * FROM stamp_approvals WHERE status = #{status} ORDER BY apply_time DESC
    </select>

    <select id="selectAllStampApprovals" resultMap="stampApprovalMap">
        SELECT * FROM stamp_approvals ORDER BY apply_time DESC
    </select>

    <update id="updateStampApproval" parameterType="com.ceams.model.entity.StampApproval">
        UPDATE stamp_approvals SET
            approver_id = #{approverId},
            approver_name = #{approverName},
            status = #{status},
            reject_reason = #{rejectReason},
            contract_path = #{contractPath},
            approval_time = NOW(),
            update_time = NOW()
        WHERE id = #{id}
    </update>
</mapper>
