<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXAccountReportController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <Label text="财务报表" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="项目ID:" />
        <TextField fx:id="projectIdField" promptText="可选" />
        <Label text="项目名称:" />
        <ComboBox fx:id="projectNameComboBox" promptText="可选" />
        <Button text="刷新项目列表" onAction="#refreshProjectList" />
        <Label text="开始日期:" />
        <DatePicker fx:id="startDatePicker" />
        <Label text="结束日期:" />
        <DatePicker fx:id="endDatePicker" />
        <Button text="生成报表" onAction="#generateReport" />
    </HBox>
    
    <VBox spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-width: 1px; -fx-padding: 10px;">
        <Label text="财务汇总" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <HBox spacing="20.0">
            <Label text="总记录数: " />
            <Label fx:id="totalCountLabel" text="0" />
            <Label text="总收入: " />
            <Label fx:id="totalIncomeLabel" text="0.00" />
            <Label text="总支出: " />
            <Label fx:id="totalExpenseLabel" text="0.00" />
            <Label text="净收入: " />
            <Label fx:id="netAmountLabel" text="0.00" />
        </HBox>
    </VBox>
    
    <VBox spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-width: 1px; -fx-padding: 10px;">
        <Label text="月度统计" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="年份:" />
            <TextField fx:id="yearField" promptText="如: 2024" />
            <Button text="查看月度统计" onAction="#viewMonthlyStats" />
        </HBox>
        <VBox fx:id="monthlyStatsBox" spacing="5.0" />
    </VBox>
    
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button text="导出PDF" onAction="#exportPDF" />
        <Button text="导出Excel" onAction="#exportExcel" />
        <Button text="返回" onAction="#back" />
    </HBox>
</VBox>