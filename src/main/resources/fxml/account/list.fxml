<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="10.0" styleClass="container-fluid responsive-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXAccountController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="responsive-form">
        <TextField fx:id="projectIdField" promptText="项目ID" />
        <DatePicker fx:id="startDatePicker" promptText="开始日期" />
        <DatePicker fx:id="endDatePicker" promptText="结束日期" />
        <Button text="查询" onAction="#search" />
        <Button text="添加账目" onAction="#addAccount" />
    </HBox>
    
    <TableView fx:id="accountTable" styleClass="responsive-table">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="80.0" text="ID">
                <cellValueFactory>
                    <PropertyValueFactory property="id" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="projectIdColumn" prefWidth="120.0" text="项目ID">
                <cellValueFactory>
                    <PropertyValueFactory property="projectId" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn prefWidth="150.0" text="项目名称">
                <cellValueFactory>
                    <PropertyValueFactory property="projectName" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="typeColumn" prefWidth="100.0" text="类型">
                <cellValueFactory>
                    <PropertyValueFactory property="type" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="amountColumn" prefWidth="120.0" text="金额">
                <cellValueFactory>
                    <PropertyValueFactory property="amount" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="paymentAccountNameColumn" prefWidth="150.0" text="支付账户">
                <cellValueFactory>
                    <PropertyValueFactory property="paymentAccountName" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="transactionDateColumn" prefWidth="150.0" text="交易日期">
                <cellValueFactory>
                    <PropertyValueFactory property="transactionDate" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="descriptionColumn" prefWidth="150.0" text="描述">
                <cellValueFactory>
                    <PropertyValueFactory property="description" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="statusColumn" prefWidth="100.0" text="状态">
                <cellValueFactory>
                    <PropertyValueFactory property="status" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
    
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="button-group">
        <Button text="编辑" onAction="#editAccount" />
        <Button text="删除" onAction="#deleteAccount" />
        <Button text="财务报表" onAction="#financialReport" />
    </HBox>
    
    <!-- 分页区域 -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="responsive-form">
        <Button fx:id="firstPageButton" text="首页" />
        <Button fx:id="prevPageButton" text="上一页" />
        <Label fx:id="currentPageLabel" text="1 / 1" />
        <Button fx:id="nextPageButton" text="下一页" />
        <Button fx:id="lastPageButton" text="末页" />
        <Label text="每页显示：" />
        <ComboBox fx:id="pageSizeComboBox" />
    </HBox>
</VBox>