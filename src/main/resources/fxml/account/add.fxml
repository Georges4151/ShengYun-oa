<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<GridPane alignment="TOP_LEFT" hgap="10.0" vgap="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXAccountAddController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="300.0" />
    </columnConstraints>
    
    <Label text="归属项目:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
    <ComboBox fx:id="projectComboBox" GridPane.columnIndex="1" GridPane.rowIndex="0" />
    
    <Label text="交易类型:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <ComboBox fx:id="typeComboBox" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    
    <Label text="交易账户:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <ComboBox fx:id="paymentAccountComboBox" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    
    <Label text="分类:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <TextField fx:id="categoryField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    
    <Label text="金额:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
    <TextField fx:id="amountField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    
    <Label text="交易日期:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
    <DatePicker fx:id="transactionDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="5" />
    
    <Label text="描述:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
    <TextField fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="6" />
    
    <Label text="票据ID:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
    <TextField fx:id="receiptIdField" GridPane.columnIndex="1" GridPane.rowIndex="7" />
    
    <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="8">
        <Button text="保存" onAction="#saveAccount" />
        <Button text="取消" onAction="#cancelEdit" />
    </HBox>
</GridPane>