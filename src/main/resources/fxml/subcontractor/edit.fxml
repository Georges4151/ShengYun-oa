<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXSubcontractorController">
    <center>
        <VBox spacing="20">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
            <Label text="编辑分包商" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <GridPane hgap="10" vgap="10">
                <Label text="分包商名称:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="联系人:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="contactPersonField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label text="联系电话:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                
                <Label text="地址:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                
                <Label text="资质等级:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="qualificationLevelField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                
                <Label text="信用评级:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <TextField fx:id="creditRatingField" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                
                <Label text="归属项目:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="6">
                    <ListView fx:id="projectListView" prefHeight="100.0" />
                    <HBox spacing="5" alignment="CENTER_RIGHT">
                        <Button text="管理项目" onAction="#manageProjects" />
                    </HBox>
                </VBox>
            </GridPane>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="保存" onAction="#saveSubcontractor" />
                <Button text="取消" onAction="#cancelEdit" />
            </HBox>
        </VBox>
    </center>
</BorderPane>