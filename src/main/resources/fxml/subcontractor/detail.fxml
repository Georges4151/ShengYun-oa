<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXSubcontractorController">
    <center>
        <VBox spacing="20" padding="20">
            <Label text="分包商详情" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <GridPane hgap="10" vgap="10">
                <Label text="分包商名称:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="nameLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="联系人:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="contactPersonLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label text="联系电话:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="phoneLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                
                <Label text="地址:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <Label fx:id="addressLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                
                <Label text="资质等级:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <Label fx:id="qualificationLevelLabel" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                
                <Label text="信用评级:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <Label fx:id="creditRatingLabel" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </GridPane>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="返回" onAction="#backToList" />
            </HBox>
        </VBox>
    </center>
</BorderPane>