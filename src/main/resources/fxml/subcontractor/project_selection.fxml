<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXSubcontractorProjectController">
    <center>
        <VBox spacing="20">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label text="选择归属项目" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Label text="请选择分包商归属的项目：" />
            <ListView fx:id="projectListView" prefHeight="300.0" prefWidth="400.0" />
            <Label text="提示：选择多个项目时，请按住Ctrl键后使用鼠标点击项目" style="-fx-font-size: 12px; -fx-text-fill: #666666;" />
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="确定" onAction="#confirmProjectSelection" />
                <Button text="取消" onAction="#cancelProjectSelection" />
            </HBox>
        </VBox>
    </center>
</BorderPane>