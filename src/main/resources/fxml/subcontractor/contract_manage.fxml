<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXSubcontractorContractController">
    <center>
        <VBox spacing="20">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label text="分包商合同管理" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            
            <!-- 合同列表 -->
            <TableView fx:id="contractTable" prefHeight="300.0" prefWidth="800.0">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="80.0" text="ID">
                        <cellValueFactory>
                            <PropertyValueFactory property="id" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="contractNameColumn" prefWidth="150.0" text="合同名称">
                        <cellValueFactory>
                            <PropertyValueFactory property="contractName" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="contractNumberColumn" prefWidth="120.0" text="合同编号">
                        <cellValueFactory>
                            <PropertyValueFactory property="contractNumber" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="projectColumn" prefWidth="150.0" text="所属项目">
                        <cellValueFactory>
                            <PropertyValueFactory property="projectName" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="contractAmountColumn" prefWidth="100.0" text="合同金额">
                        <cellValueFactory>
                            <PropertyValueFactory property="contractAmount" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="paidAmountColumn" prefWidth="100.0" text="已支付金额">
                        <cellValueFactory>
                            <PropertyValueFactory property="paidAmount" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="statusColumn" prefWidth="100.0" text="状态">
                        <cellValueFactory>
                            <PropertyValueFactory property="status" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="fileNameColumn" prefWidth="150.0" text="合同文件">
                        <cellValueFactory>
                            <PropertyValueFactory property="fileName" />
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            
            <!-- 操作按钮 -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="添加合同" onAction="#addContract" />
                <Button text="编辑合同" onAction="#editContract" />
                <Button text="删除合同" onAction="#deleteContract" />
                <Button text="查看合同文件" onAction="#viewContractFile" />
                <Button text="导入结清证明" onAction="#importSettlementProof" />
                <Button text="查看结清证明" onAction="#viewSettlementProof" />
                <Button text="刷新" onAction="#refresh" />
            </HBox>
            
            <!-- 合同详情 -->
            <VBox spacing="10" style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-padding: 10;">
                <Label text="合同详情" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                <GridPane hgap="10" vgap="10">
                    <Label text="合同名称:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="contractNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    
                    <Label text="合同编号:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="contractNumberField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    
                    <Label text="所属项目:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <ComboBox fx:id="projectComboBox" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    
                    <Label text="合同金额:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="contractAmountField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    
                    <Label text="已支付金额:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <TextField fx:id="paidAmountField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    
                    <Label text="开始日期:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <DatePicker fx:id="startDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    
                    <Label text="结束日期:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <DatePicker fx:id="endDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                    
                    <Label text="状态:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                    <ComboBox fx:id="statusComboBox" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                    
                    <Label text="描述:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                    <TextField fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                    
                    <Label text="合同文件:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
                    <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="9">
                        <Button text="上传PDF" onAction="#uploadContractFile" />
                        <TextField fx:id="filePathField" editable="false" />
                    </HBox>
                </GridPane>
                
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="保存" onAction="#saveContract" />
                    <Button text="取消" onAction="#cancel" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>