<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXSubcontractorController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="nameField" promptText="分包商名称" />
        <TextField fx:id="contactField" promptText="联系人" />
        <TextField fx:id="phoneField" promptText="电话" />
        <ComboBox fx:id="projectComboBox" promptText="归属项目" />
        <Button text="查询" onAction="#search" />
        <Button text="重置" onAction="#reset" />
        <Button text="添加分包商" onAction="#addSubcontractor" />
    </HBox>
    
    <TableView fx:id="subcontractorTable" prefHeight="400.0" prefWidth="1000.0">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="80.0" text="ID">
                <cellValueFactory>
                    <PropertyValueFactory property="id" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="nameColumn" prefWidth="150.0" text="分包商名称">
                <cellValueFactory>
                    <PropertyValueFactory property="name" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="contactPersonColumn" prefWidth="120.0" text="联系人">
                <cellValueFactory>
                    <PropertyValueFactory property="contactPerson" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="phoneColumn" prefWidth="120.0" text="电话">
                <cellValueFactory>
                    <PropertyValueFactory property="phone" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="addressColumn" prefWidth="150.0" text="地址">
                <cellValueFactory>
                    <PropertyValueFactory property="address" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="qualificationLevelColumn" prefWidth="120.0" text="资质等级">
                <cellValueFactory>
                    <PropertyValueFactory property="qualificationLevel" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="creditRatingColumn" prefWidth="100.0" text="信用评级">
                <cellValueFactory>
                    <PropertyValueFactory property="creditRating" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="projectsColumn" prefWidth="200.0" text="归属项目" />
            <TableColumn fx:id="contractCountColumn" prefWidth="100.0" text="合同数量" />
            <TableColumn prefWidth="100.0" text="操作">
                <cellValueFactory>
                    <PropertyValueFactory property="id" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
    
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button text="✏️ 编辑" onAction="#edit" />
        <Button text="🗑️ 删除" onAction="#delete" />
        <Button text="📄 查看合同" onAction="#viewContracts" />
        <Button text="🔄 刷新" onAction="#refresh" />
    </HBox>
</VBox>