<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.MainController">
   <top>
      <VBox spacing="0.0">
         <children>
            <MenuBar>
               <menus>
                  <Menu mnemonicParsing="false" text="文件">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#newAccount" text="新建账目" />
                        <MenuItem mnemonicParsing="false" onAction="#uploadReceipt" text="上传票据" />
                        <MenuItem mnemonicParsing="false" onAction="#createBackup" text="创建备份" />
                        <MenuItem mnemonicParsing="false" onAction="#restoreBackup" text="恢复备份" />
                        <MenuItem mnemonicParsing="false" onAction="#exit" text="退出" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="项目管理">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#projectList" text="项目列表" />
                        <MenuItem mnemonicParsing="false" onAction="#addProject" text="添加项目" />
                        <MenuItem mnemonicParsing="false" onAction="#projectCostAnalysis" text="项目成本分析" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="账目管理">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#accountList" text="账目列表" />
                        <MenuItem mnemonicParsing="false" onAction="#addAccount" text="添加账目" />
                        <MenuItem mnemonicParsing="false" onAction="#financialReport" text="财务报表" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="票据管理">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#receiptList" text="票据列表" />
                        <MenuItem mnemonicParsing="false" onAction="#uploadReceipt" text="上传票据" />
                        <MenuItem mnemonicParsing="false" onAction="#verifyReceipt" text="票据验证" />
                        <MenuItem mnemonicParsing="false" onAction="#approvalFlow" text="审核流程" />
                        <MenuItem mnemonicParsing="false" onAction="#receiptVerification" text="票据核销" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="材料管理">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#materialList" text="材料列表" />
                        <MenuItem mnemonicParsing="false" onAction="#addMaterial" text="添加材料" />
                        <MenuItem mnemonicParsing="false" onAction="#materialReport" text="材料报表" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="分包管理">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#subcontractorList" text="分包商列表" />
                        <MenuItem mnemonicParsing="false" onAction="#addSubcontractor" text="添加分包商" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="支付管理">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#paymentList" text="账户管理" />
                        <MenuItem mnemonicParsing="false" onAction="#transactionQuery" text="收支查询" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="电子章管理">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#electronicSealApplication" text="电子章使用申请" />
                        <MenuItem mnemonicParsing="false" onAction="#electronicSealApproval" text="电子章申请审批" />
                        <MenuItem mnemonicParsing="false" onAction="#electronicSealStamp" text="电子盖章" />
                        <MenuItem mnemonicParsing="false" onAction="#stampApprovalManagement" text="盖章审批管理" />
                        <MenuItem mnemonicParsing="false" onAction="#myStampApproval" text="我的盖章审批" />
                        <MenuItem mnemonicParsing="false" onAction="#electronicSealImport" text="电子章导入" />
                        <MenuItem mnemonicParsing="false" onAction="#electronicSealManagement" text="电子章管理" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="报表中心">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#financialReport" text="财务报表" />
                        <MenuItem mnemonicParsing="false" onAction="#projectCostReport" text="项目成本报表" />
                        <MenuItem mnemonicParsing="false" onAction="#materialReport" text="材料报表" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="系统">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#systemSettings" text="系统设置" />
                        <MenuItem mnemonicParsing="false" onAction="#userManagement" text="用户管理" />
                        <MenuItem mnemonicParsing="false" onAction="#about" text="关于" />
                     </items>
                  </Menu>
               </menus>
            </MenuBar>
            <ToolBar styleClass="responsive-toolbar">
               <items>
                  <Button mnemonicParsing="false" onAction="#newAccount" text="新建账目" />
                  <Button mnemonicParsing="false" onAction="#uploadReceipt" text="上传票据" />
                  <Button mnemonicParsing="false" onAction="#projectList" text="项目管理" />
                  <Button mnemonicParsing="false" onAction="#financialReport" text="财务报表" />
                  <Button mnemonicParsing="false" onAction="#createBackup" text="创建备份" />
               </items>
            </ToolBar>
         </children>
      </VBox>
   </top>
   <center>
      <TabPane fx:id="mainTabPane">
         <tabs>
            <Tab text="首页">
               <content>
                  <VBox alignment="CENTER" styleClass="responsive-container">
                     <children>
                        <Label text="欢迎使用盛韵建筑账目管理系统">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                        <Label text="系统版本：1.0.1" />
                        <HBox alignment="CENTER" layoutY="20.0" spacing="20.0">
                           <children>
                              <VBox alignment="CENTER" spacing="10.0">
                                 <Label text="项目数量" />
                                 <Label fx:id="projectCountLabel" text="0" />
                              </VBox>
                              <VBox alignment="CENTER" spacing="10.0">
                                 <Label text="账目数量" />
                                 <Label fx:id="accountCountLabel" text="0" />
                              </VBox>
                              <VBox alignment="CENTER" spacing="10.0">
                                 <Label text="票据数量" />
                                 <Label fx:id="receiptCountLabel" text="0" />
                              </VBox>
                              <VBox alignment="CENTER" spacing="10.0">
                                 <Label text="材料数量" />
                                 <Label fx:id="materialCountLabel" text="0" />
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </center>
   <bottom>
      <HBox alignment="CENTER" prefHeight="30.0" style="-fx-background-color: #e0e0e0;">
         <children>
            <Label text="盛韵建筑账目管理系统 - v1.0.1" />
         </children>
      </HBox>
   </bottom>
</BorderPane>