<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXSystemSettingsController">
    <center>
        <TabPane fx:id="settingsTabPane" tabClosingPolicy="UNAVAILABLE">
            <!-- 基本设置标签页 -->
            <Tab text="基本设置">
                <VBox spacing="15">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20" />
                    </padding>
                    <Label text="用户偏好设置" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <GridPane hgap="10" vgap="15">
                        <Label text="语言:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <ComboBox fx:id="languageComboBox" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="中文" />
                                    <String fx:value="English" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                        
                        <Label text="字号:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ComboBox fx:id="fontSizeComboBox" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="200">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="小 (12px)" />
                                    <String fx:value="中 (14px)" />
                                    <String fx:value="大 (16px)" />
                                    <String fx:value="超大 (18px)" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </GridPane>
                    
                    <Separator />
                    
                    <Label text="通知设置" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <VBox spacing="10">
                        <HBox spacing="10">
                            <CheckBox fx:id="notificationEnabledCheckBox" text="启用通知" />
                            <CheckBox fx:id="notificationSoundCheckBox" text="通知声音" />
                        </HBox>
                    </VBox>
                    
                    <Separator />
                    
                    <Label text="分页设置" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <VBox spacing="10">
                        <HBox spacing="10">
                            <Label text="每页条数:" />
                            <Spinner fx:id="pageSizeSpinner" min="5" max="100" initialValue="10" editable="true" prefWidth="100" />
                            <Label text="条" />
                        </HBox>
                    </VBox>
                </VBox>
            </Tab>
            
            <!-- 摄像头设置标签页 -->
            <Tab text="摄像头设置">
                <VBox spacing="15">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20" />
                    </padding>
                    <GridPane hgap="10" vgap="15">
                        <Label text="可用摄像头:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <ComboBox fx:id="webcamComboBox" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250" />
                        
                        <Label text="默认摄像头:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="defaultWebcamLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-weight: bold;" />
                        
                        <Button fx:id="setDefaultWebcamButton" text="设为默认" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <Button fx:id="refreshWebcamButton" text="刷新列表" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    </GridPane>
                    
                    <HBox spacing="10" alignment="CENTER">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10" />
                        </padding>
                        <Button fx:id="testWebcamButton" text="测试摄像头" />
                    </HBox>
                </VBox>
            </Tab>
            
            <!-- 备份设置标签页 -->
            <Tab text="备份设置">
                <VBox spacing="15">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20" />
                    </padding>
                    <GridPane hgap="10" vgap="15">
                        <CheckBox fx:id="autoBackupCheckBox" text="启用自动备份" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2" />
                        
                        <Label text="备份间隔(天):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Spinner fx:id="backupIntervalSpinner" min="1" max="365" initialValue="7" editable="true" prefWidth="100" />
                            <Label text="天" />
                        </HBox>
                        
                        <Label text="备份路径:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <TextField fx:id="backupPathTextField" prefWidth="250" />
                            <Button fx:id="browseBackupPathButton" text="浏览" />
                        </HBox>
                        
                        <Label text="保留天数:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <Spinner fx:id="backupKeepDaysSpinner" min="1" max="365" initialValue="30" editable="true" prefWidth="100" />
                            <Label text="天" />
                        </HBox>
                        
                        <CheckBox fx:id="backupCompressionCheckBox" text="启用备份压缩" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2" />
                    </GridPane>
                    
                    <HBox spacing="10" alignment="CENTER">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10" />
                        </padding>
                        <Button fx:id="backupNowButton" text="立即备份" />
                        <Button fx:id="restoreBackupButton" text="恢复备份" />
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>
    
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
            <Button fx:id="saveButton" text="保存设置" style="-fx-font-weight: bold;" />
            <Button fx:id="cancelButton" text="取消" />

        </HBox>
    </bottom>
</BorderPane>