<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXUserController">
    <top>
        <VBox spacing="10" style="-fx-padding: 10;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="👥" style="-fx-font-size: 16px;" />
                <Label text="用户管理" styleClass="title" />
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="搜索用户名或姓名" prefWidth="300" />
                <Button fx:id="searchButton" text="🔍 搜索" onAction="#search" />
                <Button fx:id="refreshButton" text="🔄 刷新" onAction="#refresh" />
                <Button fx:id="addButton" text="➕ 添加用户" onAction="#addUser" />
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="10" style="-fx-padding: 10;">
            <TableView fx:id="userTable" prefWidth="800" prefHeight="400">
                <columns>
                    <TableColumn fx:id="userIdColumn" text="用户ID" prefWidth="80" />
                    <TableColumn fx:id="usernameColumn" text="用户名" prefWidth="120" />
                    <TableColumn fx:id="nameColumn" text="姓名" prefWidth="120" />
                    <TableColumn fx:id="roleColumn" text="角色" prefWidth="100" />
                    <TableColumn fx:id="statusColumn" text="状态" prefWidth="100" />
                    <TableColumn fx:id="createTimeColumn" text="创建时间" prefWidth="150" />
                    <TableColumn fx:id="actionColumn" text="操作" prefWidth="130" />
                </columns>
            </TableView>
            <Pagination fx:id="pagination" pageCount="1" style="-fx-padding: 10;" />
        </VBox>
    </center>
</BorderPane>