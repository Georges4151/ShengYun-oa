<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<BorderPane prefHeight="850.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.NotificationManagementController">
    <stylesheets>
        <URL value="@../css/modern-theme.css" />
    </stylesheets>
    
    <top>
        <VBox spacing="0" style="-fx-background-color: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 24 32;">
                <StackPane style="-fx-pref-width: 48px; -fx-pref-height: 48px; -fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 12px;">
                    <Label text="📢" style="-fx-font-size: 24px;"/>
                </StackPane>
                <VBox spacing="4">
                    <Label text="通知管理中心" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="创建、管理和发布系统通知" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                </VBox>
                <HBox alignment="CENTER_RIGHT" spacing="16" HBox.hgrow="ALWAYS">
                    <Button text="✨ 创建通知" onAction="#createNotification" style="-fx-background-color: white; -fx-text-fill: #667eea; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 2);"/>
                    <Button text="🔄 刷新" onAction="#refreshNotifications" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 8px; -fx-cursor: hand;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="0" style="-fx-background-color: #F7FAFC;">
            <HBox spacing="16" style="-fx-padding: 20 32; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                <HBox spacing="8" style="-fx-background-color: #EDF2F7; -fx-background-radius: 8px; -fx-padding: 8 12;">
                    <Label text="🔍" style="-fx-font-size: 14px;"/>
                    <TextField fx:id="searchField" promptText="搜索通知标题或内容..." style="-fx-background-color: transparent; -fx-pref-width: 280px; -fx-font-size: 14px; -fx-text-fill: #2D3748; -fx-prompt-text-fill: #A0AEC0;"/>
                </HBox>
                <HBox spacing="8">
                    <ComboBox fx:id="statusFilter" promptText="状态筛选" style="-fx-pref-width: 140px; -fx-background-radius: 8px; -fx-font-size: 14px;"/>
                    <ComboBox fx:id="typeFilter" promptText="类型筛选" style="-fx-pref-width: 140px; -fx-background-radius: 8px; -fx-font-size: 14px;"/>
                    <Button text="筛选" onAction="#filterNotifications" style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8px; -fx-cursor: hand;"/>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="12" HBox.hgrow="ALWAYS">
                    <HBox spacing="8" style="-fx-background-color: #F7FAFC; -fx-background-radius: 8px; -fx-padding: 8 12;">
                        <Label text="📊" style="-fx-font-size: 14px;"/>
                        <Label fx:id="totalCountLabel" text="共 0 条通知" style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                    </HBox>
                </HBox>
            </HBox>
            
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: #F7FAFC;">
                <VBox spacing="16" style="-fx-padding: 24 32;">
                    <VBox fx:id="notificationListContainer" spacing="12" style="-fx-background-color: transparent;">
                        <Label text="加载中..." style="-fx-text-fill: #999; -fx-font-size: 14px; -fx-padding: 40 0;"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" spacing="16" style="-fx-padding: 16 32; -fx-background-color: white; -fx-border-width: 1 0 0 0; -fx-border-color: #E2E8F0;">
            <Button fx:id="prevPageBtn" text="◀ 上一页" onAction="#prevPage" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 6px; -fx-cursor: hand;"/>
            <HBox spacing="4" alignment="CENTER">
                <Label fx:id="pageInfoLabel" text="第 1 页 / 共 1 页" style="-fx-text-fill: #4A5568; -fx-font-size: 13px; -fx-padding: 0 12;"/>
            </HBox>
            <Button fx:id="nextPageBtn" text="下一页 ▶" onAction="#nextPage" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 6px; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>
