<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<GridPane alignment="TOP_LEFT" hgap="10.0" vgap="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXMaterialController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="300.0" />
    </columnConstraints>
    
    <Label text="材料名称:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
    <TextField fx:id="materialNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
    
    <Label text="材料编码:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <TextField fx:id="materialCodeField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    
    <Label text="规格:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <TextField fx:id="specificationField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    
    <Label text="单位:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <TextField fx:id="unitField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    
    <Label text="当前价格:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
    <TextField fx:id="currentPriceField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    
    <Label text="供应商ID:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
    <TextField fx:id="supplierIdField" GridPane.columnIndex="1" GridPane.rowIndex="5" />
    
    <Label text="分类ID:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
    <TextField fx:id="categoryIdField" GridPane.columnIndex="1" GridPane.rowIndex="6" />
    
    <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="7">
        <Button text="保存" onAction="#saveMaterial" />
        <Button text="取消" onAction="#cancelEdit" />
    </HBox>
</GridPane>