<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXMaterialController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="🧱" style="-fx-font-size: 14px;" />
        <Label text="材料列表" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <TextField fx:id="nameField" promptText="材料名称" />
        <TextField fx:id="codeField" promptText="材料编码" />
        <TextField fx:id="specField" promptText="规格" />
        <Button text="🔍 查询" onAction="#search" />
        <Button text="➕ 添加材料" onAction="#addMaterial" />
        <Button text="✏️ 编辑" onAction="#editMaterial" />
        <Button text="🗑️ 删除" onAction="#deleteMaterial" />
        <Button text="📊 材料报表" onAction="#viewReport" />
        <Button text="🔄 刷新" onAction="#refresh" />
    </HBox>

    <TableView fx:id="materialTable" prefHeight="350.0" prefWidth="800.0">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="80.0" text="ID">
                <cellValueFactory>
                    <PropertyValueFactory property="id" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="materialNameColumn" prefWidth="150.0" text="材料名称">
                <cellValueFactory>
                    <PropertyValueFactory property="materialName" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="materialCodeColumn" prefWidth="120.0" text="材料编码">
                <cellValueFactory>
                    <PropertyValueFactory property="materialCode" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="specificationColumn" prefWidth="150.0" text="规格">
                <cellValueFactory>
                    <PropertyValueFactory property="specification" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="unitColumn" prefWidth="80.0" text="单位">
                <cellValueFactory>
                    <PropertyValueFactory property="unit" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="currentPriceColumn" prefWidth="120.0" text="当前价格">
                <cellValueFactory>
                    <PropertyValueFactory property="currentPrice" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="supplierIdColumn" prefWidth="100.0" text="供应商ID">
                <cellValueFactory>
                    <PropertyValueFactory property="supplierId" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="categoryIdColumn" prefWidth="100.0" text="分类ID">
                <cellValueFactory>
                    <PropertyValueFactory property="categoryId" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn prefWidth="100.0" text="操作">
                <cellValueFactory>
                    <PropertyValueFactory property="id" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <Pagination fx:id="pagination" pageCount="1" style="-fx-padding: 10;" />
</VBox>
