<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXMaterialReportController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <Label text="材料报表" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="分类ID:" />
        <TextField fx:id="categoryIdField" promptText="可选" />
        <Label text="供应商ID:" />
        <TextField fx:id="supplierIdField" promptText="可选" />
        <Button text="生成报表" onAction="#generateReport" />
    </HBox>
    
    <VBox spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-width: 1px; -fx-padding: 10px;">
        <Label text="材料汇总" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <HBox spacing="20.0">
            <Label text="材料总数: " />
            <Label fx:id="totalCountLabel" text="0" />
            <Label text="平均价格: " />
            <Label fx:id="averagePriceLabel" text="0.00" />
            <Label text="最高价格: " />
            <Label fx:id="maxPriceLabel" text="0.00" />
            <Label text="最低价格: " />
            <Label fx:id="minPriceLabel" text="0.00" />
        </HBox>
    </VBox>
    
    <VBox spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-width: 1px; -fx-padding: 10px;">
        <Label text="材料分类统计" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <VBox fx:id="categoryStatsBox" spacing="5.0" />
    </VBox>
    
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button text="导出PDF" onAction="#exportPDF" />
        <Button text="导出Excel" onAction="#exportExcel" />
        <Button text="返回" onAction="#back" />
    </HBox>
</VBox>