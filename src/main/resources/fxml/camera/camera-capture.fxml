<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>
<?import javafx.stage.StageStyle?>

<VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: #2c3e50;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.CameraCaptureController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
    </padding>

    <!-- 标题 -->
    <Label text="📷 摄像头拍摄" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;">
        <font>
            <Font name="Microsoft YaHei Bold" size="20.0" />
        </font>
    </Label>

    <!-- 摄像头选择 -->
    <HBox spacing="10.0" alignment="CENTER">
        <Label text="选择摄像头:" style="-fx-font-size: 13px; -fx-text-fill: white;" />
        <ComboBox fx:id="cameraComboBox" prefWidth="300" style="-fx-font-size: 13px;" />
    </HBox>

    <!-- 摄像头预览区域 -->
    <VBox spacing="10.0" alignment="CENTER" style="-fx-background-color: black; -fx-background-radius: 10; -fx-padding: 10;">
        <ImageView fx:id="cameraPreview" fitHeight="400" fitWidth="550" style="-fx-border-color: #3498db; -fx-border-width: 3; -fx-border-radius: 5;" />
    </VBox>

    <!-- 拍摄预览区域 -->
    <VBox spacing="8.0" alignment="CENTER" style="-fx-background-color: #34495e; -fx-background-radius: 8; -fx-padding: 10;">
        <Label text="📸 拍摄预览" style="-fx-font-size: 12px; -fx-text-fill: #bdc3c7;" />
        <ImageView fx:id="capturePreview" fitHeight="100" fitWidth="130" style="-fx-border-color: #27ae60; -fx-border-width: 2; -fx-border-radius: 3;" />
    </VBox>

    <!-- 操作按钮 -->
    <HBox spacing="20.0" alignment="CENTER" style="-fx-padding: 10 0;">
        <Button fx:id="captureButton" text="📸 拍摄" onAction="#captureImage" disable="true" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 35; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand;" />
        <Button fx:id="retakeButton" text="🔄 重拍" onAction="#retakeImage" disable="true" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 35; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand;" />
        <Button fx:id="confirmButton" text="✅ 确认使用" onAction="#confirmCapture" disable="true" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 25; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand;" />
        <Button text="❌ 取消" onAction="#cancelCapture" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 25; -fx-font-size: 15px; -fx-cursor: hand;" />
    </HBox>

    <!-- 状态提示 -->
    <Label fx:id="statusLabel" text="请先打开摄像头" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;" />
</VBox>
