<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: #f5f7fa;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXUsbSealManagementController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="🔐 U盘电子章安全管理" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
            <font>
                <Font name="Microsoft YaHei Bold" size="20.0" />
            </font>
        </Label>
    </HBox>

    <Separator style="-fx-background-color: #3498db;" />

    <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;">
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="🔌 U盘状态:" style="-fx-font-weight: bold;" />
            <Label fx:id="usbStatusLabel" text="检测中..." style="-fx-text-fill: #7f8c8d;" />
        </HBox>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="📁 选择U盘:" style="-fx-font-weight: bold;" />
            <ComboBox fx:id="usbDriveComboBox" prefWidth="300" onAction="#onUsbDriveChanged" />
            <Button text="🔄 刷新" onAction="#onRefreshUsb" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 4;" />
            <Button text="⚙️ 初始化U盘" onAction="#onInitUsb" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 4;" />
        </HBox>
    </VBox>

    <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;">
        <Label text="📋 电子章列表" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

        <HBox spacing="15.0">
            <TableView fx:id="sealTable" prefHeight="250.0" HBox.hgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="印章名称" prefWidth="120" />
                    <TableColumn fx:id="typeColumn" text="印章类型" prefWidth="100" />
                    <TableColumn fx:id="storageColumn" text="存储方式" prefWidth="100" />
                    <TableColumn fx:id="statusColumn" text="状态" prefWidth="80" />
                    <TableColumn fx:id="usageCountColumn" text="使用次数" prefWidth="80" />
                </columns>
            </TableView>

            <VBox spacing="10.0" alignment="TOP_CENTER" style="-fx-padding: 10;">
                <Label text="预览" style="-fx-font-weight: bold;" />
                <ImageView fx:id="sealPreview" fitWidth="120" fitHeight="120" preserveRatio="true" style="-fx-border-color: #ddd; -fx-border-radius: 5;" />
            </VBox>
        </HBox>
    </VBox>

    <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;">
        <Label text="⚙️ 操作" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <Button fx:id="importToUsbButton" text="📤 导入到U盘" onAction="#onImportToUsb" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" />
            <Button fx:id="importFromUsbButton" text="📥 从U盘导出" onAction="#onImportFromUsb" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" />
            <Button fx:id="deleteSealButton" text="🗑️ 删除电子章" onAction="#onDeleteSeal" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" />
        </HBox>
    </VBox>

    <HBox spacing="15.0" alignment="CENTER">
        <Label text="💡 提示: U盘存储的电子章需要插入U盘并输入密码才能使用" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />
        <Button fx:id="closeButton" text="❌ 关闭" onAction="#onClose" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 5;" />
    </HBox>
</VBox>
