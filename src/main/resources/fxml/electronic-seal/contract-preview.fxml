<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXContractPreviewController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <Label fx:id="titleLabel" text="合同预览" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
        <font>
            <Font name="Microsoft YaHei" size="18.0" />
        </font>
    </Label>

    <Separator style="-fx-background-color: #ecf0f1;" />

    <HBox spacing="10.0" alignment="CENTER" style="-fx-background-color: #f8f9fa; -fx-padding: 8; -fx-background-radius: 5;">
        <Button fx:id="prevPageButton" text="⬅ 上一页" onAction="#prevPage"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 5 15; -fx-font-size: 12px; -fx-background-radius: 3;" />

        <Label fx:id="pageLabel" text="第 1 页 / 共 1 页" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-min-width: 120; -fx-alignment: center;" />

        <Button fx:id="nextPageButton" text="下一页 ➡" onAction="#nextPage"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 5 15; -fx-font-size: 12px; -fx-background-radius: 3;" />

        <Separator orientation="VERTICAL" style="-fx-background-color: #bdc3c7;" />

        <Button fx:id="zoomOutButton" text="🔍 缩小" onAction="#zoomOut"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 5 15; -fx-font-size: 12px; -fx-background-radius: 3;" />

        <Button fx:id="zoomInButton" text="🔍 放大" onAction="#zoomIn"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 5 15; -fx-font-size: 12px; -fx-background-radius: 3;" />
    </HBox>

    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-color: #ecf0f1;">
        <VBox alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #ecf0f1;">
            <ImageView fx:id="pdfImageView" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 0);" />
        </VBox>
    </ScrollPane>

    <HBox spacing="15.0" alignment="CENTER">
        <Button fx:id="closeButton" text="关闭预览" onAction="#close"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 25; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5;" />
    </HBox>
</VBox>
