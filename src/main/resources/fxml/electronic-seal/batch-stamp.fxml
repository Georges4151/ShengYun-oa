<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<GridPane alignment="TOP_LEFT" hgap="10.0" vgap="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXBatchStampController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="150.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="300.0" />
    </columnConstraints>

    <Label text="合同文件:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
    <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
        <TextField fx:id="contractPathField" editable="false" />
        <Button text="选择文件" onAction="#selectContract" />
    </HBox>

    <Label text="选择印章:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <ComboBox fx:id="sealComboBox" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="300.0" />

    <Label text="水平位置 (%):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
        <Slider fx:id="xPositionSlider" min="0" max="100" value="80" showTickLabels="true" showTickMarks="true" />
        <Label fx:id="xPositionLabel" text="80%" />
    </VBox>

    <Label text="垂直位置 (%):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
        <Slider fx:id="yPositionSlider" min="0" max="100" value="20" showTickLabels="true" showTickMarks="true" />
        <Label fx:id="yPositionLabel" text="20%" />
    </VBox>

    <Label text="印章大小 (%):" GridPane.columnIndex="0" GridPane.rowIndex="4" />
    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
        <Slider fx:id="scaleSlider" min="10" max="100" value="50" showTickLabels="true" showTickMarks="true" />
        <Label fx:id="scaleLabel" text="50%" />
    </VBox>

    <Label text="盖章页码:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
    <TextField fx:id="pageRangeField" promptText="all 或 1,3,5-10" text="all" GridPane.columnIndex="1" GridPane.rowIndex="5" />

    <Label text="说明:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
    <Label text="支持格式: all（全部页面）, 1,3,5（指定页面）, 1-5（页面范围）" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6" />

    <Label text="进度:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="7">
        <ProgressBar fx:id="progressBar" prefWidth="300.0" progress="0" />
        <Label fx:id="progressLabel" text="等待开始..." />
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="8">
        <Button text="开始批量盖章" onAction="#startBatchStamp" />
        <Button text="取消" onAction="#cancel" />
    </HBox>
</GridPane>
