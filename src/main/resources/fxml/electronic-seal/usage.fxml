<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXElectronicSealUsageController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <Label text="电子章使用" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    
    <!-- 使用表单 -->
    <GridPane hgap="10.0" vgap="10.0">
        <Label text="选择电子章:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="sealComboBox" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        
        <Label text="使用目的:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextArea fx:id="purposeTextArea" prefHeight="80.0" prefWidth="300.0" promptText="请输入使用电子章的目的..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
        
        <Label text="文档类型:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="documentTypeField" prefWidth="200.0" promptText="请输入文档类型" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        
        <Label text="文档路径:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="documentPathField" prefWidth="300.0" promptText="请输入文档保存路径" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>
    
    <HBox spacing="10.0">
        <Button fx:id="useSealButton" text="使用电子章" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
        <Button fx:id="cancelButton" text="取消" />
    </HBox>
    
    <Separator />
    
    <!-- 我的使用记录 -->
    <Label text="我的使用记录" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
    <TableView fx:id="usageTable" prefHeight="300.0" prefWidth="600.0">
        <columns>
            <TableColumn fx:id="sealNameColumn" prefWidth="150.0" text="电子章名称" />
            <TableColumn fx:id="purposeColumn" prefWidth="200.0" text="使用目的" />
            <TableColumn fx:id="documentTypeColumn" prefWidth="100.0" text="文档类型" />
            <TableColumn fx:id="usageTimeColumn" prefWidth="150.0" text="使用时间" />
        </columns>
    </TableView>
</VBox>