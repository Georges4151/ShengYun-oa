<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXElectronicSealStampController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <Label text="电子章盖章" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
        <font>
            <Font name="Microsoft YaHei" size="20.0" />
        </font>
    </Label>

    <Separator style="-fx-background-color: #ecf0f1;" />

    <!-- 选择项目和合同 -->
    <HBox spacing="15.0" alignment="CENTER_LEFT">
        <Label text="项目名称:" style="-fx-font-weight: bold;" />
        <ComboBox fx:id="projectComboBox" prefWidth="200.0" promptText="请选择项目" />

        <Label text="合同名称:" style="-fx-font-weight: bold;" />
        <Label fx:id="contractNameLabel" text="未选择文件" style="-fx-text-fill: #3498db; -fx-font-size: 14px; -fx-font-weight: bold;" />

        <Label text="电子章:" style="-fx-font-weight: bold;" />
        <ComboBox fx:id="sealComboBox" prefWidth="150.0" promptText="请选择电子章" />
    </HBox>

    <!-- 选择文件和预览区域 -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button fx:id="selectFileButton" text="📂 选择PDF文件" onAction="#selectFile"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 8 20; -fx-border-radius: 3; -fx-background-radius: 3;" />
        <Label fx:id="fileNameLabel" text="未选择文件" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;" />
    </HBox>

    <!-- PDF预览和印章拖动区域 -->
    <HBox spacing="10.0" VBox.vgrow="ALWAYS">
        <!-- 左侧：PDF预览 -->
        <VBox spacing="5.0" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" HBox.hgrow="ALWAYS">
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="📄 PDF预览（拖动印章到指定位置）" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                <HBox spacing="5.0" alignment="CENTER" style="-fx-background-color: #f0f0f0; -fx-background-radius: 3; -fx-padding: 5 10;">
                    <Button fx:id="prevPageButton" text="◀ 上一页" onAction="#prevPage"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 5 10; -fx-font-size: 12px; -fx-border-radius: 3; -fx-background-radius: 3;" />
                    <Label fx:id="pageLabel" text="第 1 / 1 页" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Button fx:id="nextPageButton" text="下一页 ▶" onAction="#nextPage"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 5 10; -fx-font-size: 12px; -fx-border-radius: 3; -fx-background-radius: 3;" />
                </HBox>
            </HBox>

            <Pane fx:id="previewPane" prefWidth="600.0" prefHeight="500.0" style="-fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-radius: 3;">
                <ImageView fx:id="pdfImageView" preserveRatio="true" />
                <ImageView fx:id="sealImageView" preserveRatio="true" mouseTransparent="false"
                           style="-fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 2, 2);" />
            </Pane>
        </VBox>

        <!-- 右侧：操作说明 -->
        <VBox spacing="10.0" prefWidth="200.0" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10; -fx-background-color: #f8f9fa;">
            <Label text="📋 操作说明" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #34495e;" />

            <VBox spacing="5.0">
                <Label text="1. 选择项目和合同" wrapText="true" />
                <Label text="2. 选择电子章" wrapText="true" />
                <Label text="3. 点击'选择PDF文件'" wrapText="true" />
                <Label text="4. 选择要盖章的页面" wrapText="true" style="-fx-text-fill: #3498db; -fx-font-weight: bold;" />
                <Label text="5. 拖动印章到指定位置" wrapText="true" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;" />
                <Label text="6. 点击'盖章并导出'" wrapText="true" />
            </VBox>

            <Separator />

            <Label fx:id="positionLabel" text="位置: 未设置" style="-fx-font-weight: bold; -fx-text-fill: #27ae60;" />

            <Separator />

            <Label text="📍 印章位置列表" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
            
            <ListView fx:id="stampPositionListView" prefHeight="120.0" style="-fx-border-color: #bdc3c7; -fx-border-radius: 3;" />

            <VBox spacing="10.0" alignment="CENTER">
                <Button fx:id="addStampPositionButton" text="➕ 添加印章位置（当前页）" onAction="#addStampPosition"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 8 15; -fx-font-size: 12px; -fx-border-radius: 3; -fx-background-radius: 3;" />

                <Button fx:id="addAllPagesButton" text="📄 应用到所有页面" onAction="#applyToAllPages"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 8 15; -fx-font-size: 12px; -fx-border-radius: 3; -fx-background-radius: 3;" />

                <Button fx:id="selectPagesButton" text="☑️ 选择页面范围" onAction="#showPageSelectionDialog"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-padding: 8 15; -fx-font-size: 12px; -fx-border-radius: 3; -fx-background-radius: 3;" />

                <HBox spacing="5.0" alignment="CENTER">
                    <TextField fx:id="pageRangeField" promptText="页码范围：1,3,5-10" prefWidth="120" />
                    <Button fx:id="applyToRangeButton" text="应用到指定页" onAction="#applyToPageRange"
                            style="-fx-background-color: #16a085; -fx-text-fill: white; -fx-padding: 8 10; -fx-font-size: 11px; -fx-border-radius: 3; -fx-background-radius: 3;" />
                </HBox>

                <Button fx:id="clearPositionsButton" text="🗑️ 清除所有位置" onAction="#clearStampPositions"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-padding: 8 15; -fx-font-size: 12px; -fx-border-radius: 3; -fx-background-radius: 3;" />

                <Button fx:id="stampButton" text="✅ 批量盖章并导出" onAction="#stampAndExport"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" />

                <Button fx:id="exportPdfButton" text="📄 仅导出PDF" onAction="#exportPdf"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 8 15; -fx-font-size: 12px; -fx-border-radius: 3; -fx-background-radius: 3;" />

                <Button fx:id="closeButton" text="❌ 关闭" onAction="#close"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 15; -fx-font-size: 12px; -fx-border-radius: 3; -fx-background-radius: 3;" />
            </VBox>
        </VBox>
    </HBox>

    <!-- 盖章记录 -->
    <Separator style="-fx-background-color: #ecf0f1;" />

    <Label text="📋 盖章记录" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34495e;" />

    <TableView fx:id="stampTable" prefHeight="200.0" prefWidth="800.0" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5;">
        <columns>
            <TableColumn fx:id="sealNameColumn" prefWidth="150.0" text="电子章名称" />
            <TableColumn fx:id="projectNameColumn" prefWidth="200.0" text="项目名称" />
            <TableColumn fx:id="contractNameColumn" prefWidth="200.0" text="合同名称" />
            <TableColumn fx:id="positionColumn" prefWidth="150.0" text="位置" />
            <TableColumn fx:id="stampTimeColumn" prefWidth="150.0" text="盖章时间" />
        </columns>
    </TableView>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Label fx:id="totalCountLabel" text="共 0 条记录" style="-fx-text-fill: #7f8c8d;" />
    </HBox>
</VBox>
