<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.ceams.ui.controller.FXVerifyPaymentController" prefHeight="800.0" prefWidth="800.0">
    <BorderPane layoutX="0.0" layoutY="0.0" prefHeight="1000.0" prefWidth="800.0">
        <!-- 顶部标题栏（不变） -->
        <top>
            <VBox style="-fx-background-color: #f0f2f5;">
                <Label alignment="CENTER" prefHeight="60.0" prefWidth="800.0" text="票据核销" style="-fx-background-color: #4a90e2; -fx-text-fill: white;">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                    <padding>
                        <Insets top="10.0" right="0.0" bottom="10.0" left="0.0" />
                    </padding>
                </Label>
            </VBox>
        </top>

        <!-- 中间内容区（仅调整核销记录列表高度） -->
        <center>
            <VBox spacing="15.0" style="-fx-background-color: #f5f7fa; -fx-padding: 15;">
                <!-- 票据基本信息（不变） -->
                <VBox spacing="12.0" style="-fx-background-color: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 20;">
                    <Label text="票据基本信息" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #333;"></Label>
                    <GridPane hgap="15.0" vgap="12.0" prefWidth="750.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" minWidth="80.0" prefWidth="80.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" prefWidth="200.0" />
                            <ColumnConstraints hgrow="NEVER" minWidth="80.0" prefWidth="80.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" prefWidth="200.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="NEVER" />
                            <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="NEVER" />
                            <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="NEVER" />
                        </rowConstraints>

                        <Label text="票据ID:" style="-fx-font-weight: bold; -fx-text-fill: #555;" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <tooltip>
                                <Tooltip text="唯一标识该票据的ID" />
                            </tooltip>
                        </Label>
                        <TextField fx:id="receiptIdField" editable="false" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-radius: 4;" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <tooltip>
                                <Tooltip text="唯一标识该票据的ID" />
                            </tooltip>
                        </TextField>

                        <Label text="报票人:" style="-fx-font-weight: bold; -fx-text-fill: #555;" GridPane.rowIndex="0" GridPane.columnIndex="2">
                            <tooltip>
                                <Tooltip text="提交该票据的人员姓名" />
                            </tooltip>
                        </Label>
                        <TextField fx:id="reporterNameField" editable="false" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-radius: 4;" GridPane.rowIndex="0" GridPane.columnIndex="3">
                            <tooltip>
                                <Tooltip text="提交该票据的人员姓名" />
                            </tooltip>
                        </TextField>

                        <Label text="项目名称:" style="-fx-font-weight: bold; -fx-text-fill: #555;" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <tooltip>
                                <Tooltip text="该票据所属的项目名称" />
                            </tooltip>
                        </Label>
                        <TextField fx:id="projectNameField" editable="false" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-radius: 4;" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <tooltip>
                                <Tooltip text="该票据所属的项目名称" />
                            </tooltip>
                        </TextField>

                        <Label text="票据金额:" style="-fx-font-weight: bold; -fx-text-fill: #555;" GridPane.rowIndex="1" GridPane.columnIndex="2">
                            <tooltip>
                                <Tooltip text="票据的总金额" />
                            </tooltip>
                        </Label>
                        <TextField fx:id="amountField" editable="false" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-radius: 4;" GridPane.rowIndex="1" GridPane.columnIndex="3">
                            <tooltip>
                                <Tooltip text="票据的总金额" />
                            </tooltip>
                        </TextField>

                        <Label text="已支付金额:" style="-fx-font-weight: bold; -fx-text-fill: #555;" GridPane.rowIndex="2" GridPane.columnIndex="0">
                            <tooltip>
                                <Tooltip text="已经核销支付的金额" />
                            </tooltip>
                        </Label>
                        <TextField fx:id="paidAmountField" editable="false" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-radius: 4;" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <tooltip>
                                <Tooltip text="已经核销支付的金额" />
                            </tooltip>
                        </TextField>

                        <Label text="剩余金额:" style="-fx-font-weight: bold; -fx-text-fill: #555;" GridPane.rowIndex="2" GridPane.columnIndex="2">
                            <tooltip>
                                <Tooltip text="票据剩余未核销的金额" />
                            </tooltip>
                        </Label>
                        <TextField fx:id="remainingAmountField" editable="false" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-radius: 4;" GridPane.rowIndex="2" GridPane.columnIndex="3">
                            <tooltip>
                                <Tooltip text="票据剩余未核销的金额" />
                            </tooltip>
                        </TextField>
                    </GridPane>
                </VBox>

                <!-- 核销信息（不变） -->
                <VBox spacing="12.0" style="-fx-background-color: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 20;">
                    <Label text="核销信息" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #333;"></Label>
                    <GridPane hgap="15.0" vgap="12.0" prefWidth="750.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" minWidth="100.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="220.0" />
                            <ColumnConstraints hgrow="NEVER" minWidth="100.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="220.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="NEVER" />
                            <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="NEVER" />
                            <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="NEVER" />
                            <RowConstraints minHeight="35.0" prefHeight="35.0" vgrow="NEVER" />
                            <RowConstraints minHeight="100.0" prefHeight="100.0" vgrow="NEVER" />
                        </rowConstraints>

                        <Label text="核销金额:" style="-fx-font-weight: bold; -fx-text-fill: #555;" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <tooltip>
                                <Tooltip text="本次要核销的金额" />
                            </tooltip>
                        </Label>
                        <TextField fx:id="verificationAmountField" promptText="请输入核销金额" style="-fx-border-color: #e0e0e0; -fx-border-radius: 4;" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <tooltip>
                                <Tooltip text="本次要核销的金额" />
                            </tooltip>
                        </TextField>

                        <Label text="支付账户:" style="-fx-font-weight: bold; -fx-text-fill: #555;" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <tooltip>
                                <Tooltip text="选择本次核销使用的支付账户" />
                            </tooltip>
                        </Label>
                        <ComboBox fx:id="paymentAccountComboBox" style="-fx-border-color: #e0e0e0; -fx-border-radius: 4;" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <tooltip>
                                <Tooltip text="选择本次核销使用的支付账户" />
                            </tooltip>
                        </ComboBox>

                        <Label text="核销人ID:" style="-fx-font-weight: bold; -fx-text-fill: #555;" GridPane.rowIndex="2" GridPane.columnIndex="0">
                            <tooltip>
                                <Tooltip text="执行核销操作的人员ID" />
                            </tooltip>
                        </Label>
                        <TextField fx:id="verifiedByField" promptText="请输入核销人ID" style="-fx-border-color: #e0e0e0; -fx-border-radius: 4;" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <tooltip>
                                <Tooltip text="执行核销操作的人员ID" />
                            </tooltip>
                        </TextField>

                        <Label text="核销时间:" style="-fx-font-weight: bold; -fx-text-fill: #555;" GridPane.rowIndex="3" GridPane.columnIndex="0">
                            <tooltip>
                                <Tooltip text="选择本次核销的时间" />
                            </tooltip>
                        </Label>
                        <DatePicker fx:id="verificationTimePicker" style="-fx-border-color: #e0e0e0; -fx-border-radius: 4;" GridPane.rowIndex="3" GridPane.columnIndex="1">
                            <tooltip>
                                <Tooltip text="选择本次核销的时间" />
                            </tooltip>
                        </DatePicker>

                        <Label text="备注:" style="-fx-font-weight: bold; -fx-text-fill: #555;" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.valignment="TOP">
                            <tooltip>
                                <Tooltip text="添加本次核销的备注信息" />
                            </tooltip>
                        </Label>
                        <TextArea fx:id="remarkTextArea" prefHeight="90.0" prefWidth="620.0" promptText="请输入备注信息" style="-fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-wrap-text: true;" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="3">
                            <tooltip>
                                <Tooltip text="添加本次核销的备注信息" />
                            </tooltip>
                        </TextArea>
                    </GridPane>
                </VBox>

                <!-- 核销记录列表（核心调整：增大高度） -->
                <VBox spacing="12.0" prefHeight="400.0" style="-fx-background-color: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 20;">

                    <Label text="核销记录" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #333;"></Label>
                    <!-- 关键调整：prefHeight 从 200 改为 350，同时设置 maxHeight 支持自适应滚动 -->
                    <TableView fx:id="verificationTable" prefHeight="350.0" maxHeight="Infinity" style="-fx-border-color: #e0e0e0; -fx-border-radius: 6; -fx-background-radius: 6;">
                        <columns>
                            <TableColumn prefWidth="100.0" text="支付金额" >
                                <cellValueFactory>
                                    <PropertyValueFactory property="verificationAmount" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="120.0" text="支付时间" >
                                <cellValueFactory>
                                    <PropertyValueFactory property="verificationTime" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="90.0" text="支付方式" >
                                <cellValueFactory>
                                    <PropertyValueFactory property="paymentMethod" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="110.0" text="支付账户" >
                                <cellValueFactory>
                                    <PropertyValueFactory property="paymentAccountName" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="90.0" text="核销人" >
                                <cellValueFactory>
                                    <PropertyValueFactory property="verifiedByName" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="180.0" text="支付备注" >
                                <cellValueFactory>
                                    <PropertyValueFactory property="remark" />
                                </cellValueFactory>
                            </TableColumn>
                        </columns>
                        <padding>
                            <Insets top="5.0" right="0.0" bottom="5.0" left="0.0" />
                        </padding>
                    </TableView>
                </VBox>
            </VBox>
        </center>

        <!-- 底部按钮区（不变） -->
        <bottom>
            <HBox alignment="CENTER" spacing="30.0" style="-fx-background-color: white; -fx-padding: 15; -fx-border-top: 1px solid #e0e0e0;">
                <Button fx:id="verifyButton" mnemonicParsing="false" onAction="#verifyPayment" text="确认核销" style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 10 30; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;">
                    <tooltip>
                        <Tooltip text="点击确认进行票据核销" />
                    </tooltip>
                </Button>
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#cancel" text="取消" style="-fx-background-color: #ffffff; -fx-text-fill: #666; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 10 30; -fx-border-color: #e0e0e0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;">
                    <tooltip>
                        <Tooltip text="点击取消核销操作" />
                    </tooltip>
                </Button>
            </HBox>
        </bottom>
    </BorderPane>
</AnchorPane>