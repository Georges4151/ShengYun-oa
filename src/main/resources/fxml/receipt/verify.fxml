<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXReceiptController" spacing="0" style="-fx-background-color: #f5f5f5;">

    <!-- 标题区域 -->
    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 15 20; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 2, 0, 0, 1);">
        <Label text="票据验证" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
        <HBox alignment="CENTER_RIGHT" styleClass="flex-grow" />
        <Button text="新建验证" onAction="#createVerification" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 6 15; -fx-background-radius: 4; -fx-font-size: 12px;" />
    </HBox>

    <!-- 验证规则配置区域 -->
    <VBox spacing="10.0" style="-fx-padding: 15 20 10 20;">
        <VBox spacing="8.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);">
            <Label text="验证规则配置" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            <HBox spacing="25.0" alignment="CENTER_LEFT">
                <CheckBox fx:id="checkAmountCheckBox" text="金额校验" selected="true" style="-fx-font-size: 12px;" />
                <CheckBox fx:id="checkDateCheckBox" text="日期校验" selected="true" style="-fx-font-size: 12px;" />
                <CheckBox fx:id="checkTypeCheckBox" text="类型校验" selected="true" style="-fx-font-size: 12px;" />
                <CheckBox fx:id="checkProjectCheckBox" text="项目校验" selected="true" style="-fx-font-size: 12px;" />
                <CheckBox fx:id="checkDuplicateCheckBox" text="重复校验" selected="true" style="-fx-font-size: 12px;" />
                <CheckBox fx:id="checkOCACheckBox" text="OCR校验" selected="true" style="-fx-font-size: 12px;" />
            </HBox>
        </VBox>
    </VBox>

    <!-- 主内容区域 - 使用ScrollPane包裹 -->
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" style="-fx-background-color: #f5f5f5;">
        <VBox spacing="15.0" style="-fx-padding: 10 20 20 20;">
            <!-- 票据列表和详情区域 -->
            <HBox spacing="15.0" HBox.hgrow="ALWAYS">
                <!-- 左侧：票据列表 -->
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 15 15 10 15; -fx-border-color: #f0f0f0; -fx-border-width: 0 0 1 0;">
                        <Label text="待验证票据" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <Label text="双击选择" style="-fx-font-size: 11px; -fx-text-fill: #999;" />
                    </HBox>
                    <!-- 搜索筛选 -->
                    <HBox spacing="8.0" style="-fx-padding: 8 15; -fx-background-color: #fafafa; -fx-border-color: #f0f0f0; -fx-border-width: 0 0 1 0;">
                        <TextField fx:id="searchField" promptText="搜索..." prefWidth="150" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                        <ComboBox fx:id="statusComboBox" promptText="状态" prefWidth="100" style="-fx-background-radius: 3;" />
                        <Button text="查询" onAction="#search" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 5 12; -fx-background-radius: 3; -fx-font-size: 12px;" />
                    </HBox>
                    <TableView fx:id="receiptTable" onMouseClicked="#onReceiptSelected" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="ID" prefWidth="40" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="报票人" prefWidth="80">
                                <cellValueFactory><PropertyValueFactory property="reporterName"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="项目" prefWidth="100">
                                <cellValueFactory><PropertyValueFactory property="projectName"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="金额" prefWidth="80" style="-fx-alignment: CENTER_RIGHT;">
                                <cellValueFactory><PropertyValueFactory property="amount"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="类型" prefWidth="60" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="type"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="状态" prefWidth="70" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="verificationStatusText"/></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                </VBox>

                <!-- 右侧：验证详情 -->
                <VBox spacing="10.0" style="-fx-min-width: 350; -fx-max-width: 400;" VBox.vgrow="ALWAYS">
                    <!-- 票据信息卡片 -->
                    <VBox spacing="10.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);">
                        <Label text="票据信息" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <GridPane hgap="10" vgap="8">
                            <Label text="票据ID:" style="-fx-text-fill: #999; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="receiptIdField" GridPane.columnIndex="1" GridPane.rowIndex="0" editable="false" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                            <Label text="报票人:" style="-fx-text-fill: #999; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <TextField fx:id="reporterNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" editable="false" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                            <Label text="项目:" style="-fx-text-fill: #999; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <TextField fx:id="projectNameField" GridPane.columnIndex="1" GridPane.rowIndex="2" editable="false" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                            <Label text="金额:" style="-fx-text-fill: #999; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <TextField fx:id="amountField" GridPane.columnIndex="1" GridPane.rowIndex="3" editable="false" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                            <Label text="描述:" style="-fx-text-fill: #999; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <TextField fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="4" editable="false" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                        </GridPane>
                    </VBox>

                    <!-- 发票图片和OCR结果 -->
                    <HBox spacing="10.0">
                        <VBox spacing="5.0" style="-fx-padding: 12; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);" HBox.hgrow="ALWAYS">
                            <Label text="发票原件" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                            <ImageView fx:id="receiptImageView" fitWidth="150" fitHeight="100" preserveRatio="true" style="-fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-cursor: hand;" onMouseClicked="#showLargeImage" />
                        </VBox>
                        <VBox spacing="5.0" style="-fx-padding: 12; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);" HBox.hgrow="ALWAYS">
                            <Label text="OCR识别" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                            <TextArea fx:id="ocrResultTextArea" prefHeight="100" editable="false" style="-fx-background-radius: 3; -fx-font-size: 11px;" />
                        </VBox>
                    </HBox>

                    <!-- 验证结果卡片 -->
                    <VBox spacing="8.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="验证结果" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                            <Label fx:id="verificationStatusLabel" text="待验证" style="-fx-font-size: 11px; -fx-text-fill: #FF9800; -fx-padding: 2 8; -fx-background-color: #FFF3E0; -fx-background-radius: 3;" />
                        </HBox>
                        <HBox spacing="15.0">
                            <VBox spacing="3.0">
                                <HBox spacing="5.0"><Label fx:id="checkAmountResult" text="✓" style="-fx-font-size: 11px; -fx-text-fill: #4CAF50;" /><Label text="金额" style="-fx-font-size: 11px; -fx-text-fill: #666;" /></HBox>
                                <HBox spacing="5.0"><Label fx:id="checkDateResult" text="✓" style="-fx-font-size: 11px; -fx-text-fill: #4CAF50;" /><Label text="日期" style="-fx-font-size: 11px; -fx-text-fill: #666;" /></HBox>
                                <HBox spacing="5.0"><Label fx:id="checkTypeResult" text="✓" style="-fx-font-size: 11px; -fx-text-fill: #4CAF50;" /><Label text="类型" style="-fx-font-size: 11px; -fx-text-fill: #666;" /></HBox>
                            </VBox>
                            <VBox spacing="3.0">
                                <HBox spacing="5.0"><Label fx:id="checkProjectResult" text="✓" style="-fx-font-size: 11px; -fx-text-fill: #4CAF50;" /><Label text="项目" style="-fx-font-size: 11px; -fx-text-fill: #666;" /></HBox>
                                <HBox spacing="5.0"><Label fx:id="checkDuplicateResult" text="✓" style="-fx-font-size: 11px; -fx-text-fill: #4CAF50;" /><Label text="重复" style="-fx-font-size: 11px; -fx-text-fill: #666;" /></HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- 验证操作区域 -->
                    <VBox spacing="10.0" style="-fx-padding: 12; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);">
                        <Label text="验证操作" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="验证状态:" style="-fx-font-size: 12px; -fx-text-fill: #666;" />
                            <ComboBox fx:id="verifyStatusComboBox" promptText="选择验证结果" prefWidth="120" style="-fx-background-radius: 3;">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="已验证" />
                                        <String fx:value="已拒绝" />
                                    </FXCollections>
                                </items>
                            </ComboBox>
                            <TextField fx:id="verifyRemarkField" promptText="验证备注（可选）" prefWidth="150" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                        </HBox>
                        <HBox spacing="8.0">
                            <Button text="执行验证" onAction="#executeVerify" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 3; -fx-font-size: 12px;" />
                            <Button text="票据核销" onAction="#verifyPayment" style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 3; -fx-font-size: 12px;" />
                            <Button text="查看详情" onAction="#viewDetail" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 3;" />
                        </HBox>
                    </VBox>

                    <!-- 验证历史记录 -->
                    <VBox spacing="8.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);" VBox.vgrow="ALWAYS">
                        <Label text="验证历史" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <TableView fx:id="verificationHistoryTable" style="-fx-background-radius: 3;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn text="时间" prefWidth="80" style="-fx-alignment: CENTER;">
                                    <cellValueFactory><PropertyValueFactory property="verificationTime"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="规则" prefWidth="70">
                                    <cellValueFactory><PropertyValueFactory property="ruleName"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="结果" prefWidth="50" style="-fx-alignment: CENTER;">
                                    <cellValueFactory><PropertyValueFactory property="resultText"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="验证人" prefWidth="60">
                                    <cellValueFactory><PropertyValueFactory property="verifierName"/></cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
