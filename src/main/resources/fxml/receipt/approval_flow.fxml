<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXApprovalFlowController" spacing="0" style="-fx-background-color: #f5f5f5;">

    <!-- 标题区域 -->
    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 15 20; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 2, 0, 0, 1);">
        <Label text="审核流程管理" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
        <HBox alignment="CENTER_RIGHT" styleClass="flex-grow" />
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <Label text="审核级别:" style="-fx-font-size: 13px; -fx-text-fill: #666;" />
            <ComboBox fx:id="approvalLevelComboBox" onAction="#onApprovalLevelChanged" prefWidth="150" style="-fx-background-radius: 4;" />
        </HBox>
    </HBox>

    <!-- 统计卡片区域 -->
    <HBox spacing="15.0" style="-fx-padding: 15 20 10 20;">
        <VBox spacing="5.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);" HBox.hgrow="ALWAYS">
            <Label text="待审核" style="-fx-font-size: 12px; -fx-text-fill: #999;" />
            <Label text="12" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #FF9800;" />
        </VBox>
        <VBox spacing="5.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);" HBox.hgrow="ALWAYS">
            <Label text="已通过" style="-fx-font-size: 12px; -fx-text-fill: #999;" />
            <Label text="156" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" />
        </VBox>
        <VBox spacing="5.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);" HBox.hgrow="ALWAYS">
            <Label text="已驳回" style="-fx-font-size: 12px; -fx-text-fill: #999;" />
            <Label text="8" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F44336;" />
        </VBox>
        <VBox spacing="5.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);" HBox.hgrow="ALWAYS">
            <Label text="本周处理" style="-fx-font-size: 12px; -fx-text-fill: #999;" />
            <Label text="45" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2196F3;" />
        </VBox>
    </HBox>

    <!-- 主内容区域 - 使用ScrollPane包裹 -->
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" style="-fx-background-color: #f5f5f5;">
        <VBox spacing="15.0" style="-fx-padding: 10 20 20 20;">
            <!-- 票据列表和详情区域 -->
            <HBox spacing="15.0" HBox.hgrow="ALWAYS">
                <!-- 左侧：待审核票据列表 -->
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 15 15 10 15; -fx-border-color: #f0f0f0; -fx-border-width: 0 0 1 0;">
                        <Label text="待审核票据" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <Label text="双击选择" style="-fx-font-size: 11px; -fx-text-fill: #999;" />
                    </HBox>
                    <TableView fx:id="receiptTable" onMouseClicked="#onReceiptSelected" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="ID" prefWidth="40" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="报票人" prefWidth="80">
                                <cellValueFactory><PropertyValueFactory property="reporterName"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="项目" prefWidth="100">
                                <cellValueFactory><PropertyValueFactory property="projectName"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="金额" prefWidth="80" style="-fx-alignment: CENTER_RIGHT;">
                                <cellValueFactory><PropertyValueFactory property="amount"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="类型" prefWidth="60" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="type"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="状态" prefWidth="70" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="approvalProgressText"/></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                </VBox>

                <!-- 右侧：详情和操作区域 -->
                <VBox spacing="10.0" style="-fx-min-width: 350; -fx-max-width: 400;" VBox.vgrow="ALWAYS">
                    <!-- 票据详情卡片 -->
                    <VBox spacing="10.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);">
                        <Label text="票据详情" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <GridPane hgap="10" vgap="8">
                            <Label text="票据ID:" style="-fx-text-fill: #999; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="receiptIdField" GridPane.columnIndex="1" GridPane.rowIndex="0" editable="false" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                            <Label text="报票人:" style="-fx-text-fill: #999; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <TextField fx:id="reporterNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" editable="false" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                            <Label text="项目:" style="-fx-text-fill: #999; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <TextField fx:id="projectNameField" GridPane.columnIndex="1" GridPane.rowIndex="2" editable="false" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                            <Label text="金额:" style="-fx-text-fill: #999; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <TextField fx:id="amountField" GridPane.columnIndex="1" GridPane.rowIndex="3" editable="false" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                            <Label text="日期:" style="-fx-text-fill: #999; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <TextField fx:id="receiptDateField" GridPane.columnIndex="1" GridPane.rowIndex="4" editable="false" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                            <Label text="描述:" style="-fx-text-fill: #999; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                            <TextField fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="5" editable="false" style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                        </GridPane>
                    </VBox>

                    <!-- 审核进度卡片 -->
                    <VBox spacing="8.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);">
                        <Label text="审核进度" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label text="财务审核" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                                <Label fx:id="financeStatusLabel" text="待审核" style="-fx-font-size: 10px; -fx-text-fill: #FF9800;" />
                            </VBox>
                            <Label text="→" style="-fx-font-size: 12px; -fx-text-fill: #ccc;" />
                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label text="项目经理" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                                <Label fx:id="projectManagerStatusLabel" text="待审核" style="-fx-font-size: 10px; -fx-text-fill: #FF9800;" />
                            </VBox>
                            <Label text="→" style="-fx-font-size: 12px; -fx-text-fill: #ccc;" />
                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label text="经理审核" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                                <Label fx:id="managerStatusLabel" text="待审核" style="-fx-font-size: 10px; -fx-text-fill: #FF9800;" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- 审核操作卡片 -->
                    <VBox spacing="10.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="审核操作" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                            <Label fx:id="currentLevelLabel" text="财务审核" style="-fx-font-size: 10px; -fx-text-fill: #1976D2; -fx-padding: 2 8; -fx-background-color: #E3F2FD; -fx-background-radius: 3;" />
                        </HBox>
                        <ComboBox fx:id="actionComboBox" prefWidth="150" style="-fx-background-radius: 3;" />
                        <TextArea fx:id="commentTextArea" prefHeight="50" promptText="审核意见..." style="-fx-background-radius: 3; -fx-font-size: 12px;" />
                        <HBox spacing="8.0">
                            <Button text="提交审核" onAction="#onApprove" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 3; -fx-font-size: 12px;" />
                            <Button text="查看票据" onAction="#onViewImage" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 8 12; -fx-background-radius: 3;" />
                            <Button text="历史" onAction="#onViewHistory" style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-padding: 8 12; -fx-background-radius: 3;" />
                        </HBox>
                    </VBox>

                    <!-- 审核历史记录 -->
                    <VBox spacing="8.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);" VBox.vgrow="ALWAYS">
                        <Label text="审核历史" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <TableView fx:id="historyTable" style="-fx-background-radius: 3;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn text="级别" prefWidth="60" style="-fx-alignment: CENTER;">
                                    <cellValueFactory><PropertyValueFactory property="approvalLevelText"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="审核人" prefWidth="60">
                                    <cellValueFactory><PropertyValueFactory property="approverName"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="结果" prefWidth="50" style="-fx-alignment: CENTER;">
                                    <cellValueFactory><PropertyValueFactory property="statusText"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="时间" prefWidth="80" style="-fx-alignment: CENTER;">
                                    <cellValueFactory><PropertyValueFactory property="approvalTime"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="审核意见" prefWidth="150">
                                    <cellValueFactory><PropertyValueFactory property="comment"/></cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
