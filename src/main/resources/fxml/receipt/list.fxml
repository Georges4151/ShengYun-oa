<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXReceiptController" style="-fx-background-color: #f5f5f5;">

    <!-- 标题区域 -->
    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 15 20 10 20; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);">
        <Label text="票据管理" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;" />
        <HBox alignment="CENTER_RIGHT" styleClass="flex-grow" />
        <Button text="上传票据" onAction="#uploadReceipt" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 4;" />
    </HBox>

    <!-- 搜索筛选区域 -->
    <VBox spacing="10.0" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);">
        <Label text="筛选条件" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;" />
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <VBox spacing="5.0">
                <Label text="报票人姓名" style="-fx-font-size: 12px; -fx-text-fill: #999;" />
                <TextField fx:id="reporterIdField" promptText="请输入报票人姓名" prefWidth="150.0" style="-fx-background-radius: 4;" />
            </VBox>
            <VBox spacing="5.0">
                <Label text="归属项目" style="-fx-font-size: 12px; -fx-text-fill: #999;" />
                <TextField fx:id="projectIdField" promptText="请输入项目名称" prefWidth="150.0" style="-fx-background-radius: 4;" />
            </VBox>
            <VBox spacing="5.0">
                <Label text="开始日期" style="-fx-font-size: 12px; -fx-text-fill: #999;" />
                <DatePicker fx:id="startDatePicker" promptText="选择开始日期" prefWidth="150.0" style="-fx-background-radius: 4;" />
            </VBox>
            <VBox spacing="5.0">
                <Label text="结束日期" style="-fx-font-size: 12px; -fx-text-fill: #999;" />
                <DatePicker fx:id="endDatePicker" promptText="选择结束日期" prefWidth="150.0" style="-fx-background-radius: 4;" />
            </VBox>
            <VBox spacing="5.0">
                <Label text="审核进度" style="-fx-font-size: 12px; -fx-text-fill: #999;" />
                <ComboBox fx:id="statusComboBox" prefWidth="150.0" style="-fx-background-radius: 4;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="" />
                            <String fx:value="待财务审核" />
                            <String fx:value="待项目经理审核" />
                            <String fx:value="待经理审核" />
                            <String fx:value="审核完成" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 10 0 0 0;">
            <Button text="🔍 查询" onAction="#search" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 8 25; -fx-background-radius: 4;" />
            <Button text="🔄 重置" onAction="#reset" style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-padding: 8 25; -fx-background-radius: 4;" />
        </HBox>
    </VBox>

    <!-- 操作按钮区域 -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 0 20;">
        <Button text="查看详情" onAction="#viewDetail" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 4;" />
        <Button text="验证票据" onAction="#verifyReceipt" visible="false" managed="false" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 4;" />
        <Button text="票据核销" onAction="#verifyPayment" style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 4;" />
        <Button text="删除" onAction="#deleteReceipt" style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 4;" />
    </HBox>

    <!-- 数据表格区域 -->
    <VBox spacing="10.0" style="-fx-padding: 0 20 10 20; -fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);" VBox.vgrow="ALWAYS">
        <Label text="票据列表" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666; -fx-padding: 15 15 10 15;" />
        <TableView fx:id="receiptTable" prefHeight="400.0" style="-fx-background-radius: 4; -fx-border-radius: 4;">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID">
                    <cellValueFactory>
                        <PropertyValueFactory property="id" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="reporterIdColumn" prefWidth="100.0" text="报票人">
                    <cellValueFactory>
                        <PropertyValueFactory property="reporterName" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="projectIdColumn" prefWidth="150.0" text="归属项目">
                    <cellValueFactory>
                        <PropertyValueFactory property="projectName" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="receiptDateColumn" prefWidth="120.0" text="票据日期">
                    <cellValueFactory>
                        <PropertyValueFactory property="receiptDate" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="amountColumn" prefWidth="120.0" text="金额">
                    <cellValueFactory>
                        <PropertyValueFactory property="amount" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="typeColumn" prefWidth="100.0" text="类型">
                    <cellValueFactory>
                        <PropertyValueFactory property="type" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="verificationStatusColumn" prefWidth="130.0" text="审核进度">
                    <cellValueFactory>
                        <PropertyValueFactory property="approvalProgressText" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="paymentStatusColumn" prefWidth="100.0" text="支付状态">
                    <cellValueFactory>
                        <PropertyValueFactory property="paymentStatusText" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="paymentMethodColumn" prefWidth="100.0" text="支付方式">
                    <cellValueFactory>
                        <PropertyValueFactory property="paymentMethodText" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="paidAmountColumn" prefWidth="100.0" text="支付金额">
                    <cellValueFactory>
                        <PropertyValueFactory property="paidAmount" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="remainingAmountColumn" prefWidth="100.0" text="剩余金额">
                    <cellValueFactory>
                        <PropertyValueFactory property="remainingAmount" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </VBox>

    <!-- 分页区域 -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 10 20; -fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);">
        <Button fx:id="firstPageButton" text="⏮️ 首页" style="-fx-background-color: #E0E0E0; -fx-text-fill: #333; -fx-padding: 6 15; -fx-background-radius: 4;" />
        <Button fx:id="prevPageButton" text="⬅️ 上一页" style="-fx-background-color: #E0E0E0; -fx-text-fill: #333; -fx-padding: 6 15; -fx-background-radius: 4;" />
        <Label fx:id="currentPageLabel" text="1 / 1" style="-fx-font-size: 14px; -fx-padding: 6 15;" />
        <Button fx:id="nextPageButton" text="下一页 ➡️" style="-fx-background-color: #E0E0E0; -fx-text-fill: #333; -fx-padding: 6 15; -fx-background-radius: 4;" />
        <Button fx:id="lastPageButton" text="末页 ⏭️" style="-fx-background-color: #E0E0E0; -fx-text-fill: #333; -fx-padding: 6 15; -fx-background-radius: 4;" />
        <Label text="每页显示：" style="-fx-font-size: 14px; -fx-padding: 6 10 6 20;" />
        <ComboBox fx:id="pageSizeComboBox" prefWidth="80.0" style="-fx-background-radius: 4;" />
    </HBox>
</VBox>
