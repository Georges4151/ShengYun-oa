<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="TOP_LEFT" hgap="10.0" vgap="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXReceiptController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
        <ColumnConstraints hgrow="ALWAYS" minWidth="500.0" prefWidth="600.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
        <RowConstraints minHeight="400.0" prefHeight="400.0" vgrow="ALWAYS" />
        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="NEVER" />
    </rowConstraints>
    
    <Label text="票据详情" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0" />
    
    <Label text="票据ID:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <TextField fx:id="receiptIdField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    
    <Label text="用户ID:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <TextField fx:id="receiptUserIdField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    
    <Label text="报票人:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <TextField fx:id="receiptReporterNameField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    
    <Label text="归属项目:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
    <TextField fx:id="receiptProjectNameField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    
    <Label text="票据日期:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
    <TextField fx:id="receiptDateField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />
    
    <Label text="金额:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
    <TextField fx:id="receiptAmountField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="6" />
    
    <Label text="类型:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
    <TextField fx:id="receiptTypeField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="7" />
    
    <Label text="描述:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
    <TextField fx:id="receiptDescriptionField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="8" />
    
    <Label text="文件路径:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
    <TextField fx:id="receiptFilePathField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="9" />
    
    <Label text="验证状态:" GridPane.columnIndex="0" GridPane.rowIndex="10" />
    <TextField fx:id="receiptVerificationStatusField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="10" />
    
    <Label text="发票原件:" GridPane.columnIndex="0" GridPane.rowIndex="11" GridPane.valignment="TOP" />
    <ImageView fx:id="receiptImageView" fitHeight="350.0" fitWidth="550.0" preserveRatio="true" GridPane.columnIndex="1" GridPane.rowIndex="11" onMouseClicked="#showLargeImage" />
    
    <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="12">
        <Button text="关闭" onAction="#closeDetail" />
    </HBox>
</GridPane>