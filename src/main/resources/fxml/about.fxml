<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER_LEFT" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXAboutController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    
    <Label text="关于系统" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
    
    <VBox spacing="10.0">
        <Label fx:id="appNameLabel" style="-fx-font-size: 16px;" />
        <Label fx:id="appVersionLabel" />
        <Label fx:id="appDescriptionLabel" />
        
        <Label text="技术栈" style="-fx-font-weight: bold;" />
        <TextArea fx:id="techStackTextArea" editable="false" prefHeight="150.0" prefWidth="400.0" wrapText="true" />
        
        <Label text="功能模块" style="-fx-font-weight: bold;" />
        <TextArea fx:id="featuresTextArea" editable="false" prefHeight="150.0" prefWidth="400.0" wrapText="true" />
        
        <Label text="联系方式" style="-fx-font-weight: bold;" />
        <Label fx:id="contactLabel" />
    </VBox>
</VBox>
