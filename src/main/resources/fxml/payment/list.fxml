<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ceams.ui.controller.FXPaymentController">
   <children>
      <VBox alignment="CENTER" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="50.0">
               <children>
                  <Label text="支付账户管理" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
               </children>
            </HBox>
            <HBox alignment="CENTER_RIGHT" prefHeight="50.0" spacing="10.0">
               <children>
                  <Button fx:id="addButton" mnemonicParsing="false" text="添加账户" />
                  <Button fx:id="editButton" mnemonicParsing="false" text="编辑账户" />
                  <Button fx:id="deleteButton" mnemonicParsing="false" text="删除账户" />
                  <Button fx:id="transactionButton" mnemonicParsing="false" text="收支查询" />
                  <Button fx:id="reconciliationButton" mnemonicParsing="false" text="银行对账" />
               </children>
            </HBox>
            <TableView fx:id="accountTable" VBox.vgrow="ALWAYS" style="-fx-border-color: #cccccc; -fx-border-width: 1px;">
              <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="140.0" text="账户名称" />
                <TableColumn fx:id="typeColumn" prefWidth="100.0" text="账户类型" />
                <TableColumn fx:id="balanceColumn" prefWidth="120.0" text="账户余额" />
                <TableColumn fx:id="descriptionColumn" prefWidth="240.0" text="账户描述" />
                <TableColumn fx:id="createTimeColumn" prefWidth="130.0" text="创建时间" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>